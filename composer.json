{
    "name": "semsen1/three-d-preview-field",
    "description": "Laravel Nova field: upload and preview 3D models (STL, OBJ, PLY, GLB/GLTF, 3MF, FBX)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laravel/nova": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Semsen1\\ThreeDPreviewField\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Semsen1\\ThreeDPreviewField\\FieldServiceProvider"
            ]
        }
    },
    "config": { "sort-packages": true },
    "minimum-stability": "dev",
    "prefer-stable": true
}
